    "settings.advanced.data.footer" : {
      "comment" : "Section footer",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Remove Duplicate Data' removes duplicates locally. 'Reset iCloud Sync Data' clears all data from iCloud and re-uploads your current local data."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Supprimer les données en double » supprime les doublons localement. « Réinitialiser les données de synchronisation iCloud » efface toutes les données d'iCloud et télécharge à nouveau vos données locales actuelles."
          }
        }
      }
    },
