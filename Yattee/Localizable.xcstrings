      "comment" : "Confirmation message",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will clear all synced data from iCloud and re-upload your current local data. Use this if iCloud data has become corrupted or contains duplicates."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela effacera toutes les données synchronisées d'iCloud et téléchargera à nouveau vos données locales actuelles. Utilisez-le si les données iCloud sont corrompues ou contiennent des doublons."
          }
        }
      }
    },
