    "settings.youtubeEnhancements.resolveShortLinks.footer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you tap a bit.ly, tinyurl, t.co, or similar short link in a description or comment, XTubee follows the redirect and opens the destination in-app if it's a supported video, channel, or playlist. Sends a network request to the shortener service."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous appuyez sur bit.ly, tinyurl, t.co ou un lien court similaire dans une description ou un commentaire, XTubee suit la redirection et ouvre la destination dans l'application s'il s'agit d'une vidéo, d'une chaîne ou d'une playlist prise en charge. Envoie une requête réseau au service de raccourcissement."
          }
        }
      }
    },
