      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Match Dynamic Range"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faire correspondre la plage dynamique"
          }
        }
      }
    },
    "settings.playback.tvDisplayMatching.footer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asks the Apple TV to switch its HDMI output mode to match the video being played. Also requires Match Content → Frame Rate / Dynamic Range to be enabled in tvOS Settings → Video and Audio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande à l'Apple TV de changer son mode de sortie HDMI pour correspondre à la vidéo en cours de lecture. Nécessite également que Match Content → Frame Rate / Dynamic Range soit activé dans les réglages tvOS → Vidéo et audio."
          }
        }
      }
    },
    "settings.playback.tvDisplayMatching.frameRate" : {
      "comment" : "Toggle label (tvOS only)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Match Frame Rate"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faire correspondre la fréquence d'images"
          }
        }
      }
    },
    "settings.playback.tvDisplayMatching.header" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Display"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher"
          }
        }
